# Connection string de Neon (PostgreSQL). Copia a .env.local y rellena.
# Lo obtienes del panel de Neon (Dashboard), NO del SQL Editor.
# Nunca subas .env.local al repositorio.
DATABASE_URL=

# Secreto para firmar JWT (mín. 32 caracteres).
# Generar: openssl rand -base64 32
# Pegar SOLO en este archivo (o en Vercel → Environment Variables).
# NO pegar en Neon SQL Editor (no es SQL).
JWT_SECRET=
